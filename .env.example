# Copia este archivo como .env solo para pruebas en tu computador. NUNCA subas .env a GitHub.
# Todas las variables son opcionales: si falta alguna, la tienda sigue funcionando
# (los pedidos se envían por WhatsApp y los correos se omiten con un aviso en el registro).

# --- Base de datos (Render la crea sola con el Blueprint) ---
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# --- Panel de administración: https://TU-SERVIDOR/admin ---
ADMIN_PASSWORD=pon-una-clave-larga
SESSION_SECRET=cadena-aleatoria-larga

# --- Correos (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="A&M Laminado 18k <pedidos@tudominio.com>"
OWNER_EMAIL=tu-correo@gmail.com
# Correo al cliente cuando cambias el estado del pedido (true/false)
STATUS_EMAILS=true

# --- Tienda ---
WHATSAPP_NUMBER=573008918966
PUBLIC_URL=https://am-laminado-api.onrender.com
# Direcciones de la tienda que pueden enviar pedidos a este servidor (separadas por coma)
ALLOWED_ORIGINS=https://am-laminado18k.onrender.com

# --- Envíos: el costo se confirma por WhatsApp ---
SHIPPING_MODE=convenir

# --- Wompi (DESACTIVADO). Solo se activa con WOMPI_ENABLED=true y las 3 llaves ---
# WOMPI_ENABLED=false
# WOMPI_ENV=sandbox
# WOMPI_PUBLIC_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
