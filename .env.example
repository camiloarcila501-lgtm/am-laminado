# Copia este archivo como .env para desarrollo local. NUNCA subas .env a GitHub.
# Todas las variables son opcionales: sin ninguna, la tienda funciona con pedidos por WhatsApp.

# --- General ---
PORT=3000
PUBLIC_URL=https://tu-servicio.onrender.com
WHATSAPP_NUMBER=573008918966

# --- Base de datos (Render Postgres o Supabase) ---
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos
# PGSSL=disable   # solo si tu Postgres no usa SSL

# --- Panel de administración (/admin) ---
ADMIN_PASSWORD=pon-una-clave-larga
SESSION_SECRET=cadena-aleatoria-larga

# --- Correos (Resend) ---
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="A&M laminado 18k <pedidos@tudominio.com>"
OWNER_EMAIL=tu-correo@gmail.com

# --- Pagos Wompi ---
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx

# --- Envíos ---
# convenir (por defecto): el envío se confirma por WhatsApp y se registra en /admin
# tabla: usa SHIPPING_RATES o shipping.json (ver shipping.example.json)
# carrier: adaptador de transportadora (pendiente de implementar con contrato)
SHIPPING_MODE=convenir
# SHIPPING_RATES={"zones":[{"name":"Medellín y área metropolitana","cities":["Medellín","Envigado"],"cost":10000}],"default":20000}
# FREE_SHIPPING_MIN=300000
# CARRIER_API_KEY=
